{
  "name": "investment-dashboard-app",
  "version": "1.0.0",
  "private": true,
  "description": "投资看板 Android APP",
  "scripts": {
    "smoke": "node tests/smoke.js",
    "version:check": "node tools/check-version.js",
    "bump": "node tools/bump-version.js",
    "precheck": "node tools/check-version.js && node tests/smoke.js",
    "build:plugins": "node tools/build-capacitor-plugins.js",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:build": "npx cap build android",
    "build:android": "cd android && gradlew.bat assembleDebug",
    "apkg": "npm run build:plugins && npx cap sync android && cd android && gradlew.bat assembleDebug && echo APK at android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "6.0.3"
  }
}
